# ── 授權總開關(過渡用;正式改由 licenseRegistry 判斷)
DATA_DERIVED_DISPLAY_OK=false

# ── VVIP 總開關:授權/成本/毛利門檻/候補人數全部成立前保持 false(整層隱藏)
VVIP_ENABLED=false

# ── Feature flags(未設 = 關閉,fail-safe)
F_EDU=true
F_EVENTS=false
F_BASIC_TA=false
F_FINRA_DELAYED=false
F_WATCHLIST=false
F_PRICE_ALERTS=false
F_EARN_ALERTS=false
F_MAG7=false
F_JUDGMENTS=false
F_RECORDS=false
F_13F=false
F_CONGRESS=false
F_MAXPAIN_SUM=false
F_MAXPAIN_FULL=false
F_IV=false
F_GEX=false
F_TRF_RT=false

# ── 資料庫(正式)
DATABASE_URL=postgres://REDACTED

# ── Telegram(正式;勿寫入版控)
TELEGRAM_BOT_TOKEN=REDACTED

# ── Decision Artifact 簽章密鑰(伺服器端;缺失時 publish 一律拒絕)
ARTIFACT_HMAC_SECRET=REDACTED_generate_a_long_random_string
